    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nconst monthMap = {\n  '__EMPTY':    'Enero',\n  '__EMPTY_1':  'Febrero',\n  '__EMPTY_2':  'Marzo',\n  '__EMPTY_3':  'Abril',\n  '__EMPTY_4':  'Mayo',\n  '__EMPTY_5':  'Junio',\n  '__EMPTY_6':  'Julio',\n  '__EMPTY_7':  'Agosto',\n  '__EMPTY_8':  'Septiembre',\n  '__EMPTY_9':  'Octubre',\n  '__EMPTY_10': 'Noviembre',\n  '__EMPTY_11': 'Diciembre'\n};\n\nconst mainCol = rows.length > 0 ? Object.keys(rows[0].json)[0] : 'Concepto';\n\nconst items = [];\nfor (const row of rows) {\n  const label = row.json[mainCol];\n  if (!label || String(label).trim() === '') continue;\n\n  const monthParts = Object.entries(row.json)\n    .filter(([k]) => k !== mainCol && k !== 'binary' && row.json[k] !== undefined && row.json[k] !== '')\n    .map(([k, v]) => `${monthMap[k] || k}: ${v}`);\n\n  const text = monthParts.length > 0\n    ? `${label} — ${monthParts.join(', ')}`\n    : String(label);\n\n  items.push({ json: { text } });\n}\n\nreturn items;"
      },
